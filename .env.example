# ─── Required ──────────────────────────────────────────────────────────────────

# PostgreSQL connection string (Neon or self-hosted)
DATABASE_URL=postgresql://user:password@host:5432/viona

# JWT signing secret — generate: openssl rand -hex 64
JWT_SECRET=change_me_in_production_minimum_32_chars

# Draw RNG server secret — generate: openssl rand -hex 32
DRAW_SECRET=change_me_lottery_rng_secret

# ─── Payments ──────────────────────────────────────────────────────────────────

# "mock" for dev/demo, "stripe" for production
PAYMENT_PROVIDER=mock

# Stripe (when PAYMENT_PROVIDER=stripe)
STRIPE_SECRET_KEY=sk_live_...
STRIPE_WEBHOOK_SECRET=whsec_...

# ─── Email ─────────────────────────────────────────────────────────────────────

# Resend API key (resend.com) — leave empty to log emails to console
RESEND_API_KEY=re_...
EMAIL_FROM=VIONA <noreply@viona.app>

# ─── App URL ───────────────────────────────────────────────────────────────────

APP_URL=https://viona.app

# ─── Web Push (VAPID) ──────────────────────────────────────────────────────────
# Generate: npx web-push generate-vapid-keys
# The public key is served via GET /api/push/vapid-key — no client env var needed
VAPID_PUBLIC_KEY=BEl62iUY...
VAPID_PRIVATE_KEY=...
VAPID_SUBJECT=mailto:admin@viona.app

# ─── KYC Provider ──────────────────────────────────────────────────────────────
# Sumsub (sumsub.com) — webhook at POST /api/webhooks/kyc
# Without these, KYC auto-approves in dev (mock mode).
SUMSUB_APP_TOKEN=...
SUMSUB_SECRET_KEY=...
# Level names must match your Sumsub dashboard configuration:
#   age-kyc-level    — age/selfie check (level 1)
#   basic-kyc-level  — full document + liveness (level 2)

# ─── Admin ─────────────────────────────────────────────────────────────────────
# Seed the DB on first run (dev only): POST /api/dev/seed
# Must be explicitly enabled — never set to "true" in production
SEED_ALLOWED=true
# Create first admin in DB directly or via seed

# ─── Docker only ───────────────────────────────────────────────────────────────
POSTGRES_PASSWORD=viona_dev_password
